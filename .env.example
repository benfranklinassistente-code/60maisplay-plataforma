# 60maisPlay - Plataforma de Cursos
# Copie este arquivo para .env e preencha os valores

# Ambiente: development | production
NODE_ENV=development

# Configuração do Servidor
PORT=3000

# Configuração do Banco de Dados
# Para SQLite (testes locais):
DB_FILE=./database/60maisplay.db

# Para MySQL (Hostgator / Produção):
# DB_HOST=localhost
# DB_USER=seu_usuario
# DB_PASSWORD=sua_senha
# DB_NAME=60maisplay_db
# DB_PORT=3306

# JWT Secret (gerar um valor seguro em produção)
JWT_SECRET=sua_chave_secreta_aqui_mude_em_producao

# Configurações de Email (opcional)
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=587
# SMTP_USER=benjamin@60maiscursos.com.br
# SMTP_PASS=sua_senha_smtp

# URL da aplicação
APP_URL=http://localhost:3000
